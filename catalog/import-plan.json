{
  "schema_version": 1,
  "project": "RS TV",
  "mode": "scheduled_candidate_import",
  "language": "ar",
  "endpoints": {
    "channels": "https://iptv-org.github.io/api/channels.json",
    "streams": "https://iptv-org.github.io/api/streams.json",
    "countries": "https://iptv-org.github.io/api/countries.json",
    "languages": "https://iptv-org.github.io/api/languages.json",
    "categories": "https://iptv-org.github.io/api/categories.json",
    "logos": "https://iptv-org.github.io/api/logos.json",
    "master_playlist": "https://iptv-org.github.io/iptv/index.m3u",
    "country_playlists": "https://iptv-org.github.io/iptv/countries/{country_code_lowercase}.m3u",
    "category_playlists": "https://iptv-org.github.io/iptv/categories/{category_id}.m3u",
    "language_playlists": "https://iptv-org.github.io/iptv/languages/{language_code}.m3u",
    "feeds": "https://iptv-org.github.io/api/feeds.json",
    "blocklist": "https://iptv-org.github.io/api/blocklist.json"
  },
  "field_mapping": {
    "channel_id": "channels[].id",
    "channel_name": "channels[].name",
    "country_code": "channels[].country",
    "categories": "channels[].categories",
    "official_website": "channels[].website",
    "stream_channel_id": "streams[].channel",
    "stream_url": "streams[].url",
    "stream_quality_label": "streams[].label",
    "stream_user_agent": "streams[].user_agent",
    "country_name": "countries[].name",
    "country_flag": "countries[].flag",
    "language_codes": "countries[].languages",
    "feed_channel_id": "feeds[].channel",
    "feed_languages": "feeds[].languages",
    "logo_channel_id": "logos[].channel",
    "logo_url": "logos[].url",
    "blocklisted_channel_id": "blocklist[].channel"
  },
  "country_filter": {
    "all_value": "ALL",
    "all_label_ar": "الكل",
    "all_behavior": "Show every approved channel from every country in one combined continuous list. Keep the flag and country name visible on every channel card.",
    "country_behavior": "Filter the same catalogue by exact ISO country code.",
    "flag_source": "countries.json",
    "unknown_country_behavior": "Show neutral globe icon and country label if available; never guess a flag from language."
  },
  "admission": {
    "imported_status": "candidate",
    "default_catalogue_status": "candidate",
    "required_before_approval": [
      "stable_channel_id",
      "country_code_verified",
      "stream_url_tested_repeatedly",
      "official_or_authorized_source_evidence",
      "rights_review_passed",
      "logo_attribution_checked"
    ],
    "reject_if": [
      "paid_or_encrypted_without_valid_provider_entitlement",
      "DRM_or_access_control_bypass",
      "stream_origin_or_rights_unclear",
      "repeated_playback_failures",
      "dead_or_malicious_url"
    ]
  },
  "reliability": {
    "grade_A": "Official broadcaster or authorized CDN, repeated successful playback checks across times and network locations.",
    "grade_B": "Known broadcaster-origin source with repeated checks but limited coverage.",
    "grade_C": "Community stream with insufficient or intermittent checks; hidden from default catalogue.",
    "recheck_required": true,
    "no_zero_buffering_promise": true,
    "checks_must_not_record_or_rehost_streams": true
  },
  "update_policy": {
    "metadata_refresh_hours": 24,
    "stream_health_checks": "scheduled and rate-limited; never run from every client device",
    "stale_stream_action": "hide from default catalogue pending recheck",
    "preserve_source_attribution": true
  },
  "important": "This is a discovery/import contract. Imported records are candidates, not automatically free, authorized, stable, or approved.",
  "implementation": {
    "importer": "tools/import_channel_candidates.py",
    "tests": "tools/test_import_channel_candidates.py",
    "workflow": ".github/workflows/refresh-channel-candidates.yml",
    "output": "catalog/generated/candidates.json",
    "refresh": "Daily at 04:23 UTC and manual workflow dispatch",
    "safety": "Generated records remain candidate/not_reviewed and are never directly playable."
  }
}
