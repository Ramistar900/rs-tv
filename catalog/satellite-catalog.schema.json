{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramistar900.github.io/rs-tv/schemas/satellite-catalog.schema.json",
  "title": "RS TV Global Satellite Catalogue",
  "description": "Metadata schema for satellite positions, channel identities, and individual satellite transmissions. It does not describe internet stream URLs or prove broadcast rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalogue_type", "updated_at_utc", "satellites", "channels", "transmissions"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalogue_type": { "const": "satellite_reference_metadata" },
    "updated_at_utc": { "type": "string", "format": "date-time" },
    "satellites": { "type": "array", "items": { "$ref": "#/$defs/satellite" } },
    "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
    "transmissions": { "type": "array", "items": { "$ref": "#/$defs/transmission" } }
  },
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_url", "last_verified_utc"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "last_verified_utc": { "type": "string", "format": "date-time" },
        "verification_note": { "type": "string" }
      }
    },
    "satellite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satellite_id", "name", "orbital_position_degrees", "orbital_direction", "review_status", "source_evidence"],
      "properties": {
        "satellite_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "orbital_position_degrees": { "type": "number", "minimum": 0, "maximum": 180 },
        "orbital_direction": { "enum": ["E", "W"] },
        "operator": { "type": ["string", "null"] },
        "coverage_regions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "review_status": { "enum": ["candidate", "verified", "rejected"] },
        "source_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceEvidence" } }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "name", "country_code", "languages", "categories"],
      "properties": {
        "channel_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "languages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "logo_url": { "type": ["string", "null"], "format": "uri" },
        "official_website": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "transmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transmission_id", "channel_id", "satellite_id", "frequency_mhz", "polarization", "symbol_rate_ksps", "fec", "standard", "encryption_status", "review_status", "source_evidence"],
      "properties": {
        "transmission_id": { "type": "string", "minLength": 1 },
        "channel_id": { "type": "string", "minLength": 1 },
        "satellite_id": { "type": "string", "minLength": 1 },
        "frequency_mhz": { "type": "integer", "minimum": 3000, "maximum": 15000 },
        "polarization": { "enum": ["H", "V", "L", "R"] },
        "symbol_rate_ksps": { "type": "integer", "minimum": 1 },
        "fec": { "type": "string", "minLength": 1 },
        "standard": { "enum": ["DVB-S", "DVB-S2", "DVB-S2X", "unknown"] },
        "modulation": { "type": ["string", "null"] },
        "encryption_status": { "enum": ["fta", "encrypted", "mixed", "unknown"] },
        "video_quality_hint": { "enum": ["4K_UHD", "FHD", "HD", "SD", "unknown"] },
        "review_status": { "enum": ["candidate", "technical_checked", "rights_reviewed", "approved", "rejected"] },
        "source_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceEvidence" } }
      }
    }
  }
}
